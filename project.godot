; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Jurassic Island"
config/description="侏罗纪岛 —— 第一人称生存 / 建造 / 冒险游戏。

在几十分钟的限定时间内，建造工具，抵御恐龙，最后通过救援直升机逃出恐龙岛。
low-poly 风格，2000 m × 2000 m 的大世界。

主场景：res://scenes-3d/jurassic-island/jurassic-island.tscn
（从主菜单的「开始」进入，场景别名见 autoloads/scene_manager/scenes.gd 的 \"world\"）"
config/tags=PackedStringArray("3d", "survival", "building", "low-poly")
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/show_image=false
config/icon="res://common/art/meta/icon.svg"

[audio]

buses/default_bus_layout="res://common/audio/default_bus_layout.tres"

[autoload]

SaveLoad="*res://autoloads/save_load.gd"
Scenes="*res://autoloads/scene_manager/scenes.tscn"
Audio="*res://autoloads/audio.gd"
Events="*res://autoloads/events.gd"
UserPrefs="*res://autoloads/user_prefs/user_prefs.tscn"
GameData="*res://autoloads/data/game_data.gd"
PlayerData="*res://autoloads/data/player_data.gd"
Resources="*res://autoloads/data/resources.gd"
InputHelper="*uid://cholww48njaeh"
QuickAudio="*uid://cujwm7u5pvogl"

McpBridge="*res://.mcp/godot-runtime/bridge/mcp_bridge.gd"
[display]

window/size/viewport_width=2000
window/size/viewport_height=1400
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/input_helper/plugin.cfg", "res://addons/quick_audio/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://autoloads/": "gray",
"res://common/": "red",
"res://scenes/": "blue",
"res://scenes/_common/": "red",
"res://scenes/main/": "gray"
}

[filesystem]

import/blender/enabled=false

